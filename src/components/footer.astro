---
import { Icon } from "astro-icon";
import type { FooterLink } from "~/types";

const links: Array<FooterLink> = [
  {
    url: "https://github.com/your-repo/fitme-grpc",
    description: "View source on GitHub",
    icon: "fa-brands:github-alt",
  },
  {
    url: "#",
    description: "FitME on Discord",
    icon: "fa-brands:discord",
  },
  {
    url: "#",
    description: "FitME on Twitter",
    icon: "fa-brands:twitter",
  },
  {
    url: "#",
    description: "FitME on LinkedIn",
    icon: "fa-brands:linkedin",
  },
];
---

<footer class="relative flex flex-col items-center justify-center py-16 gap-8">
  <div class="absolute inset-0 overflow-hidden opacity-20">
    <div class="h-full w-full bg-gradient-to-t from-cyan-900/50 via-transparent to-transparent"></div>
  </div>
  
  <div class="relative flex flex-col items-center gap-4">
    <Icon name="fitme-logo" class="h-12 text-primary" />
    <p class="text-offset text-sm">The AI-Driven Wellness Ecosystem</p>
  </div>
  
  <ul class="relative grid grid-cols-4 gap-4">
    {
      links.map((link) => (
        <li>
          <a
            class="flex h-12 w-12 items-center justify-center rounded-full border-2 border-current p-3 hover:border-primary hover:text-primary transition-colors"
            href={link.url}
          >
            <span class="sr-only">{link.description}</span>
            <Icon class="h-full" name={link.icon} />
          </a>
        </li>
      ))
    }
  </ul>
  
  <div class="relative text-center text-offset text-xs space-y-2">
    <p>Built with Go, gRPC, and ❤️</p>
    <p>© {new Date().getFullYear()} FitME. All rights reserved.</p>
  </div>
</footer>
