---
import { Icon } from "astro-icon";
import ContentSection from "~/components/content-section.astro";
import type { FeatureItem } from "~/types";

const features: Array<FeatureItem> = [
  {
    title: "AI Nutrition Coaching",
    description:
      "FitSynch generates personalized meal plans based on your goals, dietary restrictions, and biometric data. Auto-generates shopping lists.",
    icon: "mdi:food-fork-drink",
  },
  {
    title: "Biometric Sync",
    description:
      "Real-time ingestion from Apple Health, Oura, and Whoop. Track HRV, sleep quality, SpO2, and recovery metrics in one place.",
    icon: "mdi:watch-variant",
  },
  {
    title: "Mental Health Journaling",
    description:
      "End-to-end encrypted journaling with AI-driven mood analysis. Track patterns and receive proactive wellness suggestions.",
    icon: "mdi:head-heart",
  },
  {
    title: "Healthcare Integration",
    description:
      "FHIR-compliant data portability for telehealth partnerships. HIMS & HERS integration for clinical insights.",
    icon: "mdi:hospital-box",
  },
  {
    title: "Real-time Observability",
    description:
      "Every request traced end-to-end via OpenTelemetry. Prometheus metrics, Grafana dashboards, and Jaeger distributed tracing.",
    icon: "mdi:chart-multiple",
  },
  {
    title: "Enterprise Security",
    description:
      "End-to-end encryption, HIPAA preparedness, JWT/OAuth2 authentication, and scoped service-to-service permissions.",
    icon: "mdi:shield-lock",
  },
];
---

<ContentSection title="Features" id="features">
  <Fragment slot="lead">
    A <span class="text-primary">unified wellness platform</span> that connects
    <span class="text-primary">fitness</span>, <span class="text-primary">nutrition</span>,
    and <span class="text-primary">mental health</span> data.
  </Fragment>
  <ul class="grid max-w-6xl grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-1">
    {
      features.map(({ title, description, icon }) => (
        <li class="glass-card flex flex-col items-center gap-4 p-6 text-center">
          <div class="h-16 w-16 rounded-full border-2 border-primary bg-primary/10 p-3 flex items-center justify-center shadow-inner shadow-primary/20">
            <Icon name={icon} class="h-8 w-8 text-primary" />
          </div>
          <p class="font-extrabold text-xl">{title}</p>
          <p class="text-offset text-sm leading-relaxed">{description}</p>
        </li>
      ))
    }
  </ul>
</ContentSection>
